# ==============================================
# ATF ACMP API - Environment Variables Template
# ==============================================
# Copy this file to .env for development
# Never commit .env to version control
# ==============================================

# ----------------------------------------------
# Application
# ----------------------------------------------
NODE_ENV=development
PORT=3001

# ----------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=acmp_dev
DATABASE_SSL=false

# ----------------------------------------------
# Redis
# ----------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----------------------------------------------
# JWT Authentication
# ----------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ----------------------------------------------
# Firebase Admin SDK
# ----------------------------------------------
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com

# ----------------------------------------------
# Mailchimp Transactional (Mandrill)
# ----------------------------------------------
MAILCHIMP_API_KEY=your_mailchimp_transactional_api_key
MAILCHIMP_FROM_EMAIL=noreply@atfchallenge.org
MAILCHIMP_FROM_NAME=ATF AI Challenge

# ----------------------------------------------
# AWS S3 (File Storage)
# ----------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=acmp-uploads

# ----------------------------------------------
# Google Gemini AI
# ----------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# ----------------------------------------------
# OneSignal (Push Notifications)
# ----------------------------------------------
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# ----------------------------------------------
# CORS
# ----------------------------------------------
CORS_ORIGIN=http://localhost:3000

# ----------------------------------------------
# Logging
# ----------------------------------------------
LOG_LEVEL=debug

# ----------------------------------------------
# SMTP (Email)
# ----------------------------------------------
# For local development, use Mailpit: docker compose up mailpit
# Web UI: http://localhost:8025, SMTP: localhost:1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@atfchallenge.org
SMTP_FROM_NAME=ATF AI Challenge

# Google Calendar Integration
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Or use the path to the JSON credentials file:
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

