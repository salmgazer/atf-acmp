# ==============================================
# ATF ACMP - Docker Compose Environment Variables
# ==============================================
# Copy this file to .env for local development
# Never commit .env to version control
# ==============================================

# ----------------------------------------------
# Trusted proxy (blank locally; deployed APIs require the ALB subnet CIDRs)
# ----------------------------------------------
TRUST_PROXY_CIDRS=

# ----------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=acmp_dev

# ----------------------------------------------
# JWT Authentication
# ----------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ----------------------------------------------
# Firebase Admin SDK (API)
# ----------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=


# ----------------------------------------------
# Firebase Client SDK (Web)
# ----------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ----------------------------------------------
# Mailchimp Transactional (Mandrill)
# ----------------------------------------------
MAILCHIMP_API_KEY=
MAILCHIMP_FROM_EMAIL=noreply@atfchallenge.org
MAILCHIMP_FROM_NAME=ATF AI Challenge

# ----------------------------------------------
# AWS S3 (Optional - for file uploads)
# ----------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Google Calendar Integration
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_ADMIN_EMAIL=
GOOGLE_CALENDAR_EMAIL=

# Shared ATF Zoom host (Server-to-Server OAuth app)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Explicit Zoom host user ID or email; do not use "me".
ZOOM_HOST_USER_ID=

# Push notifications (the app ID is also used by the web client)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
