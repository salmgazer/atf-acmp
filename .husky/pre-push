#!/usr/bin/env sh

# Ensure npm is in PATH (for nvm/fnm users when running from IDE)
[ -f "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh"
[ -f "$HOME/.local/share/fnm/fnm" ] && eval "$("$HOME/.local/share/fnm/fnm" env)"
export PATH="/usr/local/bin:/opt/homebrew/bin:$PATH"

echo "🔍 Running pre-push checks..."

# Type checking
echo "📝 Type checking..."
npm run type-check || {
  echo "❌ Type check failed. Fix the errors before pushing."
  exit 1
}

# Tests
echo "🧪 Running tests..."
npm run test --if-present || {
  echo "❌ Tests failed. Fix the errors before pushing."
  exit 1
}

echo "✅ All pre-push checks passed!"
